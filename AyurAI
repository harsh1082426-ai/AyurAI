<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AYURAI | Ancient Wisdom, Modern Insights</title>
  <meta name="description" content="Discover the world of Ayurvedic botanicals, explore traditional wisdom, and understand what modern evidence reveals about natural skincare.">
  
  <!-- Custom Lotus SVG Favicon -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><path d='M50 15 C55 35 75 45 85 55 C70 65 55 55 50 85 C45 55 30 65 15 55 C25 45 45 35 50 15 Z' fill='%23C6A15B'/><circle cx='50' cy='52' r='6' fill='%23102B20'/></svg>">

  <!-- Google Fonts: Editorial Serif + Clean Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Marcellus&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    /* ==========================================================================
       1. DESIGN SYSTEM & CSS VARIABLES
       ========================================================================== */
    :root {
      --forest-dark: #102B20;
      --forest-emerald: #1D4935;
      --forest-deep: #0B1D15;
      --antique-gold: #C6A15B;
      --gold-light: #E0C78E;
      --gold-dark: #9E7D3B;
      --warm-parchment: #F5EBD5;
      --parchment-soft: #FBF6EB;
      --soft-ivory: #FFF9ED;
      --botanical-ink: #24372B;
      --ink-muted: #4A6354;
      --border-gold: rgba(198, 161, 91, 0.35);
      --font-display: 'Cinzel', serif;
      --font-heading: 'Marcellus', serif;
      --font-body: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      --shadow-sm: 0 2px 8px rgba(16, 43, 32, 0.08);
      --shadow-md: 0 8px 24px rgba(16, 43, 32, 0.12);
      --shadow-lg: 0 16px 36px rgba(11, 29, 21, 0.22);
      --transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      font-size: 16px;
    }

    body {
      background-color: var(--soft-ivory);
      color: var(--botanical-ink);
      font-family: var(--font-body);
      line-height: 1.65;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    img, svg {
      display: block;
      max-width: 100%;
    }

    button, input {
      font: inherit;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: 100%;
      max-width: 1240px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    :focus-visible {
      outline: 2px solid var(--antique-gold);
      outline-offset: 3px;
    }

    /* ==========================================================================
       2. ORNAMENTAL GRAPHICS & DIVIDERS
       ========================================================================== */
    .ornament-tag {
      font-family: var(--font-display);
      font-size: 0.72rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--antique-gold);
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      margin-bottom: 0.75rem;
    }

    .ornament-tag::before,
    .ornament-tag::after {
      content: "•";
      color: var(--antique-gold);
    }

    .gold-divider {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      margin: 1.25rem auto;
      max-width: 320px;
    }

    .gold-divider span {
      height: 1px;
      flex-grow: 1;
      background: linear-gradient(90deg, transparent, var(--antique-gold), transparent);
    }

    .gold-divider svg {
      width: 18px;
      height: 18px;
      fill: var(--antique-gold);
      flex-shrink: 0;
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.95rem 2rem;
      border-radius: 4px;
      font-size: 0.88rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      cursor: pointer;
      transition: var(--transition);
      min-height: 48px;
    }

    .btn-gold {
      background: linear-gradient(135deg, #C6A15B 0%, #B89248 100%);
      color: var(--forest-dark);
      border: 1px solid var(--gold-light);
      box-shadow: 0 4px 15px rgba(198, 161, 91, 0.3);
    }

    .btn-gold:hover {
      background: linear-gradient(135deg, #D4B06A 0%, #C6A15B 100%);
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(198, 161, 91, 0.45);
    }

    .btn-outline {
      background: rgba(16, 43, 32, 0.4);
      color: var(--soft-ivory);
      border: 1px solid var(--antique-gold);
      backdrop-filter: blur(4px);
    }

    .btn-outline:hover {
      background: rgba(198, 161, 91, 0.15);
      border-color: var(--gold-light);
      transform: translateY(-2px);
    }

    /* ==========================================================================
       3. NAVIGATION
       ========================================================================== */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 900;
      background-color: rgba(16, 43, 32, 0.96);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border-gold);
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 76px;
      padding: 0 1.25rem;
      max-width: 1300px;
      margin: 0 auto;
    }

    .brand-link {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .brand-logo-svg {
      width: 38px;
      height: 38px;
      fill: var(--antique-gold);
      filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
    }

    .brand-text-wrap {
      display: flex;
      flex-direction: column;
    }

    .brand-name {
      font-family: var(--font-display);
      font-size: 1.4rem;
      font-weight: 700;
      letter-spacing: 0.28em;
      color: var(--soft-ivory);
      line-height: 1.1;
    }

    .brand-descriptor {
      font-size: 0.58rem;
      font-weight: 600;
      letter-spacing: 0.16em;
      color: var(--gold-light);
      margin-top: 2px;
      text-transform: uppercase;
    }

    .nav-desktop {
      display: flex;
      align-items: center;
      gap: 1.8rem;
    }

    .nav-link {
      font-size: 0.88rem;
      font-weight: 500;
      letter-spacing: 0.05em;
      color: var(--warm-parchment);
      transition: var(--transition);
    }

    .nav-link:hover {
      color: var(--antique-gold);
    }

    .header-search-wrap {
      position: relative;
      display: flex;
      align-items: center;
    }

    .nav-search-input {
      background: rgba(29, 73, 53, 0.6);
      border: 1px solid var(--border-gold);
      color: var(--soft-ivory);
      padding: 0.45rem 0.85rem 0.45rem 2rem;
      border-radius: 20px;
      font-size: 0.82rem;
      width: 160px;
      transition: var(--transition);
    }

    .nav-search-input:focus {
      width: 210px;
      background: rgba(16, 43, 32, 0.95);
      border-color: var(--antique-gold);
      outline: none;
    }

    .nav-search-icon {
      position: absolute;
      left: 0.7rem;
      width: 14px;
      height: 14px;
      fill: var(--antique-gold);
      pointer-events: none;
    }

    .menu-toggle {
      display: none;
      background: none;
      border: none;
      color: var(--antique-gold);
      padding: 0.5rem;
      cursor: pointer;
    }

    .menu-toggle svg {
      width: 28px;
      height: 28px;
    }

    .mobile-menu {
      display: none;
      flex-direction: column;
      background: var(--forest-dark);
      border-bottom: 2px solid var(--antique-gold);
      padding: 1.5rem 1.25rem;
      gap: 1.25rem;
    }

    .mobile-menu.open {
      display: flex;
    }

    .mobile-menu .nav-link {
      font-size: 1.05rem;
      padding: 0.4rem 0;
      border-bottom: 1px dashed rgba(198, 161, 91, 0.2);
    }

    /* ==========================================================================
       4. HERO SECTION
       ========================================================================== */
    .hero-section {
      position: relative;
      background-color: var(--forest-dark);
      color: var(--soft-ivory);
      padding: 5rem 1.5rem 6.5rem;
      overflow: hidden;
      border-bottom: 2px solid var(--antique-gold);
    }

    .hero-backdrop-pattern {
      position: absolute;
      inset: 0;
      opacity: 0.12;
      background-image: 
        radial-gradient(#C6A15B 1px, transparent 1px),
        radial-gradient(#C6A15B 1px, #102B20 1px);
      background-size: 40px 40px;
      background-position: 0 0, 20px 20px;
      pointer-events: none;
    }

    .hero-architectural-bg {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
      opacity: 0.32;
      background: radial-gradient(circle at 50% 30%, rgba(198, 161, 91, 0.25) 0%, transparent 70%);
    }

    .hero-arch-svg {
      width: 100%;
      height: 100%;
      object-fit: cover;
      max-height: 700px;
    }

    .hero-content {
      position: relative;
      z-index: 10;
      max-width: 860px;
      margin: 0 auto;
      text-align: center;
    }

    .hero-eyebrow {
      font-family: var(--font-display);
      font-size: 0.8rem;
      letter-spacing: 0.3em;
      color: var(--gold-light);
      text-transform: uppercase;
      margin-bottom: 1rem;
      display: inline-block;
      border-bottom: 1px solid var(--border-gold);
      padding-bottom: 0.4rem;
    }

    .hero-title {
      font-family: var(--font-display);
      font-size: clamp(3rem, 7vw, 5.2rem);
      font-weight: 700;
      letter-spacing: 0.22em;
      color: var(--soft-ivory);
      line-height: 1.05;
      text-shadow: 0 4px 20px rgba(0,0,0,0.5);
      margin-bottom: 0.5rem;
    }

    .hero-slogan {
      font-family: var(--font-heading);
      font-size: clamp(1.2rem, 3vw, 1.85rem);
      color: var(--antique-gold);
      font-style: italic;
      margin-bottom: 1.5rem;
      letter-spacing: 0.04em;
    }

    .hero-supporting {
      font-size: 1.05rem;
      color: var(--warm-parchment);
      max-width: 680px;
      margin: 0 auto 2.5rem;
      line-height: 1.8;
      font-weight: 300;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.25rem;
    }

    /* ==========================================================================
       5. SIGNATURE FEATURE: PRAKRITI WISDOM VAULT
       ========================================================================== */
    .vault-section {
      padding: 5.5rem 0;
      background-color: var(--parchment-soft);
      position: relative;
    }

    .section-header {
      text-align: center;
      max-width: 780px;
      margin: 0 auto 3rem;
    }

    .section-title {
      font-family: var(--font-display);
      font-size: clamp(2rem, 4vw, 2.8rem);
      color: var(--forest-dark);
      margin-bottom: 0.75rem;
      letter-spacing: 0.06em;
    }

    .section-subtitle {
      font-family: var(--font-heading);
      font-size: 1.15rem;
      color: var(--ink-muted);
      font-style: italic;
    }

    .vault-controls {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      margin-bottom: 3rem;
      background: var(--warm-parchment);
      padding: 1.5rem;
      border-radius: 6px;
      border: 1px solid var(--border-gold);
      box-shadow: var(--shadow-sm);
    }

    .search-bar-row {
      display: flex;
      gap: 0.75rem;
      width: 100%;
    }

    .vault-search-input {
      flex-grow: 1;
      padding: 0.85rem 1.25rem;
      border: 1px solid var(--border-gold);
      background: var(--soft-ivory);
      border-radius: 4px;
      font-size: 0.95rem;
      color: var(--botanical-ink);
    }

    .vault-search-input:focus {
      outline: none;
      border-color: var(--antique-gold);
      box-shadow: 0 0 0 2px rgba(198, 161, 91, 0.2);
    }

    .btn-clear-search {
      padding: 0.85rem 1.25rem;
      background: #E8DDCA;
      border: 1px solid var(--border-gold);
      border-radius: 4px;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--botanical-ink);
      cursor: pointer;
      transition: var(--transition);
      white-space: nowrap;
    }

    .btn-clear-search:hover {
      background: var(--antique-gold);
      color: var(--forest-dark);
    }

    .category-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      justify-content: center;
    }

    .filter-btn {
      background: var(--soft-ivory);
      border: 1px solid var(--border-gold);
      color: var(--botanical-ink);
      padding: 0.45rem 1.1rem;
      font-size: 0.82rem;
      font-weight: 500;
      border-radius: 30px;
      cursor: pointer;
      transition: var(--transition);
    }

    .filter-btn:hover {
      border-color: var(--antique-gold);
      color: var(--forest-dark);
    }

    .filter-btn.active {
      background: var(--forest-dark);
      color: var(--antique-gold);
      border-color: var(--forest-dark);
    }

    .vault-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 2rem;
    }

    .ingredient-card {
      background: var(--soft-ivory);
      border: 1px solid var(--border-gold);
      border-radius: 6px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      box-shadow: var(--shadow-sm);
      transition: var(--transition);
      position: relative;
    }

    .ingredient-card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-lg);
      border-color: var(--antique-gold);
    }

    .card-illus-wrap {
      background: linear-gradient(180deg, #EFE6D1 0%, #FAF5EA 100%);
      padding: 2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      border-bottom: 1px solid var(--border-gold);
      min-height: 200px;
    }

    .card-illus-wrap svg {
      width: 135px;
      height: 135px;
      transition: transform 0.4s ease;
    }

    .ingredient-card:hover .card-illus-wrap svg {
      transform: scale(1.06);
    }

    .card-badge {
      position: absolute;
      top: 1rem;
      right: 1rem;
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      background: var(--forest-dark);
      color: var(--gold-light);
      padding: 0.3rem 0.65rem;
      border-radius: 3px;
      border: 1px solid var(--border-gold);
    }

    .card-body {
      padding: 1.6rem;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }

    .card-scientific {
      font-style: italic;
      font-size: 0.84rem;
      color: var(--ink-muted);
      margin-bottom: 0.25rem;
    }

    .card-name {
      font-family: var(--font-display);
      font-size: 1.45rem;
      color: var(--forest-dark);
      margin-bottom: 0.75rem;
    }

    .card-intro {
      font-size: 0.92rem;
      color: var(--botanical-ink);
      line-height: 1.6;
      margin-bottom: 1.5rem;
      flex-grow: 1;
    }

    .card-btn {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      background: transparent;
      border: 1px solid var(--border-gold);
      padding: 0.75rem 1rem;
      border-radius: 4px;
      font-family: var(--font-display);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--forest-dark);
      cursor: pointer;
      transition: var(--transition);
    }

    .card-btn:hover {
      background: var(--forest-dark);
      color: var(--antique-gold);
      border-color: var(--forest-dark);
    }

    .empty-state {
      text-align: center;
      padding: 4rem 1.5rem;
      grid-column: 1 / -1;
      display: none;
    }

    .empty-state.active {
      display: block;
    }

    /* ==========================================================================
       6. MODAL FOLIO (7-SECTION IN-DEPTH PROFILE)
       ========================================================================== */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 1000;
      background-color: rgba(11, 29, 21, 0.85);
      backdrop-filter: blur(8px);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }

    .modal-backdrop.open {
      display: flex;
    }

    .modal-folio {
      background-color: var(--soft-ivory);
      border: 2px solid var(--antique-gold);
      border-radius: 8px;
      max-width: 820px;
      width: 100%;
      max-height: 90vh;
      display: flex;
      flex-direction: column;
      box-shadow: 0 24px 60px rgba(0,0,0,0.5);
      animation: modalSlideUp 0.3s ease-out;
    }

    @keyframes modalSlideUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .modal-header {
      background-color: var(--forest-dark);
      color: var(--soft-ivory);
      padding: 1.25rem 1.75rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 2px solid var(--antique-gold);
      border-radius: 6px 6px 0 0;
    }

    .modal-header-titles h3 {
      font-family: var(--font-display);
      font-size: 1.4rem;
      color: var(--gold-light);
      letter-spacing: 0.05em;
    }

    .modal-header-titles p {
      font-size: 0.85rem;
      font-style: italic;
      color: var(--warm-parchment);
    }

    .modal-close-btn {
      background: none;
      border: 1px solid var(--border-gold);
      color: var(--antique-gold);
      width: 36px;
      height: 36px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 1.3rem;
      transition: var(--transition);
    }

    .modal-close-btn:hover {
      background: var(--antique-gold);
      color: var(--forest-dark);
    }

    .modal-content {
      padding: 2rem;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .modal-section {
      background: var(--parchment-soft);
      border: 1px solid var(--border-gold);
      border-left: 3px solid var(--antique-gold);
      padding: 1.25rem;
      border-radius: 4px;
    }

    .modal-section-title {
      font-family: var(--font-display);
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--forest-emerald);
      margin-bottom: 0.5rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .modal-section p, .modal-section ul {
      font-size: 0.92rem;
      color: var(--botanical-ink);
      line-height: 1.6;
    }

    .modal-section ul {
      padding-left: 1.2rem;
    }

    .modal-caution {
      background: #FFF4E5;
      border-left-color: #C6823B;
    }

    .modal-sources {
      border-left-color: #4A6354;
      background: #EFE8D8;
    }

    .modal-sources a {
      color: var(--forest-emerald);
      text-decoration: underline;
      font-weight: 600;
    }

    /* ==========================================================================
       7. FEATURE TWO: THE DUAL LENS
       ========================================================================== */
    .lens-section {
      padding: 6rem 0;
      background: linear-gradient(180deg, var(--parchment-soft) 0%, var(--warm-parchment) 100%);
      border-top: 1px solid var(--border-gold);
      border-bottom: 1px solid var(--border-gold);
    }

    .lens-container {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: stretch;
      gap: 2rem;
    }

    .lens-card {
      background: var(--soft-ivory);
      border: 1px solid var(--border-gold);
      padding: 2.5rem 2rem;
      border-radius: 6px;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
    }

    .lens-card.wisdom { border-top: 4px solid var(--antique-gold); }
    .lens-card.evidence { border-top: 4px solid var(--forest-emerald); }

    .lens-badge {
      font-family: var(--font-display);
      font-size: 0.72rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      padding: 0.25rem 0.65rem;
      border-radius: 3px;
      display: inline-block;
      margin-bottom: 1rem;
      width: fit-content;
    }

    .lens-card.wisdom .lens-badge {
      background: #FAF0D6;
      color: var(--gold-dark);
      border: 1px solid var(--border-gold);
    }

    .lens-card.evidence .lens-badge {
      background: #E4EFE8;
      color: var(--forest-emerald);
      border: 1px solid rgba(29, 73, 53, 0.2);
    }

    .lens-title {
      font-family: var(--font-display);
      font-size: 1.6rem;
      color: var(--forest-dark);
      margin-bottom: 1rem;
    }

    .lens-text {
      font-size: 0.95rem;
      color: var(--botanical-ink);
      line-height: 1.7;
      margin-bottom: 1.25rem;
    }

    .lens-middle-divider {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1rem;
    }

    .lens-line {
      width: 1px;
      flex-grow: 1;
      background: linear-gradient(180deg, transparent, var(--antique-gold), transparent);
    }

    .lens-symbol {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 1px solid var(--antique-gold);
      background: var(--soft-ivory);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: var(--shadow-sm);
    }

    .lens-symbol svg {
      width: 20px;
      height: 20px;
