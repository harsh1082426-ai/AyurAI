            7. Trusted References
          </div>
          <ul>
            ${data.sources.map(s => `<li><a href="${s.url}" target="_blank" rel="noopener noreferrer">${s.label}</a></li>`).join('')}
          </ul>
        </div>
      `;

      modalBackdrop.classList.add('open');
      document.body.style.overflow = 'hidden';
      modalCloseBtn.focus();
    }

    function closeModal() {
      modalBackdrop.classList.remove('open');
      document.body.style.overflow = '';
    }

    modalCloseBtn.addEventListener('click', closeModal);
    modalBackdrop.addEventListener('click', (e) => {
      if (e.target === modalBackdrop) closeModal();
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modalBackdrop.classList.contains('open')) {
        closeModal();
      }
    });

    /**
     * SEARCH & FILTER LISTENERS
     */
    function handleSearchInput(e) {
      searchQuery = e.target.value;
      if (e.target !== vaultSearchInput) vaultSearchInput.value = searchQuery;
      if (e.target !== headerSearchInput) headerSearchInput.value = searchQuery;
      renderCards();
    }

    vaultSearchInput.addEventListener('input', handleSearchInput);
    headerSearchInput.addEventListener('input', handleSearchInput);

    clearSearchBtn.addEventListener('click', () => {
      searchQuery = '';
      vaultSearchInput.value = '';
      headerSearchInput.value = '';
      currentCategory = 'all';
      filterButtons.forEach(b => b.classList.toggle('active', b.dataset.category === 'all'));
      renderCards();
    });

    resetSearchStateBtn.addEventListener('click', () => {
      searchQuery = '';
      vaultSearchInput.value = '';
      headerSearchInput.value = '';
      currentCategory = 'all';
      filterButtons.forEach(b => b.classList.toggle('active', b.dataset.category === 'all'));
      renderCards();
    });

    filterButtons.forEach(button => {
      button.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('active'));
        button.classList.add('active');
        currentCategory = button.getAttribute('data-category');
        renderCards();
      });
    });

    /**
     * FEATURE THREE: BOTANICAL DISCOVERY TABS
     */
    function initDiscoveryFeature() {
      discoControls.innerHTML = '';
      VAULT_DATA.forEach((item, index) => {
        const btn = document.createElement('button');
        btn.className = `disco-btn ${index === 0 ? 'active' : ''}`;
        btn.textContent = item.name;
        btn.addEventListener('click', () => {
          document.querySelectorAll('.disco-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          showDiscoveryFact(item);
        });
        discoControls.appendChild(btn);
      });
      showDiscoveryFact(VAULT_DATA[0]);
    }

    function showDiscoveryFact(item) {
      discoHeading.textContent = `${item.name} (${item.sanskrit})`;
      discoFact.textContent = item.discoveryFact;
    }

    /**
     * MOBILE MENU DRAWER
     */
    menuToggleBtn.addEventListener('click', () => {
      const isOpen = mobileMenu.classList.toggle('open');
      menuToggleBtn.setAttribute('aria-expanded', isOpen);
    });

    mobileNavItems.forEach(item => {
      item.addEventListener('click', () => {
        mobileMenu.classList.remove('open');
        menuToggleBtn.setAttribute('aria-expanded', 'false');
      });
    });

    // Initial render
    renderCards();
    initDiscoveryFeature();
  </script>
</body>
</html>
